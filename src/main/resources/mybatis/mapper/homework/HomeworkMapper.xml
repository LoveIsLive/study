<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kwang.study.homework.mapper.HomeworkMapper">

    <resultMap id="HomeworkResultMap" type="com.kwang.study.homework.pojo.Homework">
        <id property="id" column="id"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="type" column="type" />
        <result property="metaData" column="meta_data" />
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <!-- 一对多关联查询附件 -->
        <collection property="attachments" ofType="com.kwang.study.homework.pojo.Attachment"
                    select="com.kwang.study.homework.mapper.AttachmentMapper.findByOwner"
                    column="{ownerId=id, ownerType=owner_type}"/>
    </resultMap>

    <resultMap id="HomeworkDetailResultMap" type="com.kwang.study.homework.pojo.HomeworkDetail" extends="HomeworkResultMap">
        <result property="teacherName" column="teacher_name"/>
    </resultMap>

    <sql id="Join_Base_Column_List">
        h.id, h.teacher_id, h.title, h.content, h.create_time, h.update_time, h.type, h.meta_data, 'homework' AS owner_type
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO homework (teacher_id, title, content, type, meta_data)
        VALUES (#{teacherId}, #{title}, #{content}, #{type}, #{metaData})
    </insert>

    <select id="findById" resultMap="HomeworkDetailResultMap">
        SELECT <include refid="Join_Base_Column_List" />, SUBSTRING_INDEX(u.username, '_', -1) AS teacher_name
        FROM homework h
        LEFT JOIN users u ON h.teacher_id = u.id
        WHERE h.id = #{id}
    </select>

    <select id="findAll" resultMap="HomeworkDetailResultMap">
        SELECT <include refid="Join_Base_Column_List" />, SUBSTRING_INDEX(u.username, '_', -1) AS teacher_name
        FROM homework h
        LEFT JOIN users u ON h.teacher_id = u.id
        ORDER BY update_time DESC
    </select>

    <select id="findAllByTeacherId" resultMap="HomeworkDetailResultMap">
        SELECT <include refid="Join_Base_Column_List" />, SUBSTRING_INDEX(u.username, '_', -1) AS teacher_name
        FROM homework h
        LEFT JOIN users u ON h.teacher_id = u.id
        WHERE h.teacher_id = #{teacherId}
        ORDER BY update_time DESC
    </select>

    <delete id="deleteById">
        DELETE FROM homework WHERE id = #{id}
    </delete>

    <update id="updateById" parameterType="com.kwang.study.homework.pojo.Homework">
        UPDATE
        homework
        <set>
            <if test="title != null">
                title = #{title},
            </if>
            <if test="content != null">
                content = #{content},
            </if>
            <if test="type != null">
                type = #{type},
            </if>
            <if test="metaData != null">
                meta_data = #{metaData},
            </if>
        </set>
        WHERE
        id = #{id}
    </update>

</mapper>