<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kwang.study.mapper.fs.NodeMapper">

    <resultMap id="BaseResultMap" type="com.kwang.study.pojo.fs.Node">
        <id property="id" column="id" />
        <result property="parentId" column="parent_id" />
        <result property="name" column="name" />
        <result property="type" column="type" />
        <result property="permissions" column="permissions" />
        <result property="size" column="size" />
        <result property="createTime" column="create_time" />
        <result property="modifyTime" column="modify_time" />
        <result property="hashId" column="hash_id" />
        <result property="mimeTypeId" column="mime_type_id" />
    </resultMap>

    <!-- 用于JOIN查询的 DTO ResultMap -->
    <resultMap id="NodeDetailResultMap" type="com.kwang.study.dto.fs.result.NodeDetailDTO" extends="BaseResultMap">
        <result property="mimeTypeName" column="mime_type_name"/>
    </resultMap>


    <sql id="Base_Column_List">
        id, parent_id, `name`, `type`, permissions, `size`, create_time, modify_time, hash_id, mime_type_id
    </sql>

    <sql id="Join_N_Base_Column_List">
        n.id, n.parent_id, n.`name`, n.`type`, n.permissions, n.`size`, n.create_time, n.modify_time, n.hash_id, n.mime_type_id
    </sql>

    <insert id="insertNode" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO node (parent_id, `name`, `type`, permissions, `size`, hash_id, mime_type_id)
        VALUES (#{parentId}, #{name}, #{type}, #{permissions}, #{size}, #{hashId}, #{mimeTypeId})
    </insert>

    <update id="updateNode">
        UPDATE node
        <set>
            <if test="name != null and name != ''">
                `name` = #{name},
            </if>
            <if test="permissions != null and permissions != ''">
                permissions = #{permissions},
            </if>
            <if test="size != null">
                `size` = #{size},
            </if>
            <if test="type != null">
                `type` = #{type},
            </if>
            <if test="hashId != null">
                hash_id = #{hashId},
            </if>
            <if test="mimeTypeId != null">
                mime_type_id = #{mimeTypeId},
            </if>
            modify_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteNodeById">
        DELETE FROM node WHERE id = #{id}
    </delete>

    <delete id="batchDeleteNodeByIds">
        DELETE FROM node
        WHERE id IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectNodeById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM node
        WHERE id = #{id}
    </select>

    <select id="selectNodesByIds" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM node
        WHERE id IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectNodeByParentIdAndName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM node
        WHERE <if test="parentId != null">
                parent_id = #{parentId}
              </if>
              <if test="parentId == null">
                parent_id IS NULL
              </if>
              AND `name` = #{name}
    </select>

    <select id="selectChildrenByParentId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM node
        WHERE
        <if test="parentId != null">
            parent_id = #{parentId}
        </if>
        <if test="parentId == null">
            parent_id IS NULL
        </if>
        <if test="types != null and !types.isEmpty()">
            AND `type` IN
            <foreach item="type" collection="types" open="(" separator="," close=")">
                #{type}
            </foreach>
        </if>
    </select>

    <select id="selectAllDescendantIds" resultType="long">
        WITH RECURSIVE descendants AS (
            SELECT id FROM node WHERE id = #{id}
            UNION ALL
            SELECT n.id FROM node n JOIN descendants d ON n.parent_id = d.id
        )
        SELECT id FROM descendants WHERE id != #{id};
    </select>

    <select id="selectNodeDetailById" resultMap="NodeDetailResultMap">
        SELECT
        <include refid="Join_N_Base_Column_List" />,
        mt.name AS mime_type_name
        FROM
        node n
        LEFT JOIN
        mime_types mt ON n.mime_type_id = mt.id
        WHERE
        n.id = #{id}
    </select>

    <select id="selectChildrenDetailByParentId" resultMap="NodeDetailResultMap">
        SELECT
        <include refid="Join_N_Base_Column_List" />,
        mt.name AS mime_type_name
        FROM
        node n
        LEFT JOIN
        mime_types mt ON n.mime_type_id = mt.id
        WHERE
        <if test="parentId != null">
            n.parent_id = #{parentId}
        </if>
        <if test="parentId == null">
            n.parent_id IS NULL
        </if>
        <if test="types != null and !types.isEmpty()">
            AND n.`type` IN
            <foreach item="type" collection="types" open="(" separator="," close=")">
                #{type}
            </foreach>
        </if>
    </select>

    <update id="updateNodeParentAndName">
        UPDATE node
        <set>
            <if test="newParentId != null">
                parent_id = #{newParentId},
            </if>
            <if test="newName != null and newName != ''">
                `name` = #{newName},
            </if>
            modify_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectFullPathById" resultType="string">
        <if test="id == null">
            SELECT '/' AS fullPath
        </if>
        <if test="id != null">
        WITH RECURSIVE path_cte (id, name, parent_id, level) AS (
            SELECT id, name, parent_id, 0 as level
            FROM node
            WHERE id = #{id}
            UNION ALL
            SELECT n.id, n.name, n.parent_id, p.level + 1
            FROM node n
                     JOIN path_cte p ON n.id = p.parent_id
        )
        SELECT CONCAT('/', GROUP_CONCAT(name ORDER BY level DESC SEPARATOR '/')) AS fullPath
        FROM path_cte
        WHERE name IS NOT NULL AND name != '';
        </if>
    </select>

    <select id="searchNodesByName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM node
        WHERE `name` LIKE #{namePattern}
        <if test="types != null and !types.isEmpty()">
            AND `type` IN
            <foreach item="type" collection="types" open="(" separator="," close=")">
                #{type}
            </foreach>
        </if>
    </select>

</mapper>