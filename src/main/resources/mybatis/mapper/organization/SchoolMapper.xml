<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kwang.study.organization.mapper.SchoolMapper">

    <resultMap id="BaseResultMap" type="com.kwang.study.organization.pojo.School">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>

        <result property="classCount" column="class_count" />
    </resultMap>

    <sql id="Base_Column_List">
        id, `name`, create_time, update_time
    </sql>

    <!-- 查询所有 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT s.id, s.`name`, s.create_time, s.update_time, COUNT(c.id) AS class_count
        FROM schools s
        LEFT JOIN classes c ON s.id = c.school_id
        GROUP BY s.id
        ORDER BY s.id ASC
    </select>

    <select id="selectBatchIds" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM schools
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY id ASC
    </select>

    <!-- 根据ID查询 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT s.id, s.`name`, s.create_time, s.update_time, COUNT(c.id) AS class_count
        FROM schools s
        LEFT JOIN classes c ON s.id = c.school_id
        WHERE s.id = #{id}
        GROUP BY s.id
    </select>

    <!-- 根据名称查询 (补充的方法) -->
    <select id="findByName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM schools
        WHERE `name` = #{name}
        LIMIT 1
    </select>

    <select id="matchByName" resultMap="BaseResultMap">
        SELECT s.id, s.`name`, s.create_time, s.update_time, COUNT(c.id) AS class_count
        FROM schools s
                 LEFT JOIN classes c ON s.id = c.school_id
        WHERE s.`name` LIKE CONCAT('%', #{key}, '%')
        GROUP BY s.id
        ORDER BY s.id ASC
    </select>

    <!-- 插入 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="com.kwang.study.organization.pojo.School">
        INSERT INTO schools (`name`, create_time, update_time)
        VALUES (#{name}, NOW(), NOW())
    </insert>

    <!-- 更新 -->
    <update id="update" parameterType="com.kwang.study.organization.pojo.School">
        UPDATE schools
        SET `name` = #{name}
        WHERE id = #{id}
    </update>

    <!-- 删除 -->
    <delete id="deleteById" parameterType="long">
        DELETE FROM schools
        WHERE id = #{id}
    </delete>

</mapper>