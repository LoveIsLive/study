<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kwang.study.discussion.mapper.DiscussionPostMapper">

    <resultMap id="DiscussionPostDetailResultMap" type="com.kwang.study.discussion.pojo.DiscussionPostDetail">
        <id property="id" column="id"/>
        <result property="ownerId" column="owner_id"/>
        <result property="ownerType" column="owner_type"/>
        <result property="parentId" column="parent_id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <!-- 关联查询用户信息 -->
        <result property="username" column="username"/>
    </resultMap>

    <sql id="Base_Column_List">
        p.id, p.owner_id, p.owner_type, p.parent_id, p.user_id, p.content, p.is_deleted, p.create_time, p.update_time
    </sql>

    <sql id="Join_User_Column_List">
        <include refid="Base_Column_List"/>, SUBSTRING_INDEX(u.username, '_', -1) AS username
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" parameterType="com.kwang.study.discussion.pojo.DiscussionPost">
        INSERT INTO discussion_post (owner_id, owner_type, parent_id, user_id, content)
        VALUES (#{ownerId}, #{ownerType}, #{parentId}, #{userId}, #{content})
    </insert>

    <select id="findDetailById" resultMap="DiscussionPostDetailResultMap">
        SELECT <include refid="Join_User_Column_List"/>
        FROM discussion_post p
        LEFT JOIN users u ON p.user_id = u.id
        WHERE p.id = #{id} AND p.is_deleted = 0
    </select>

    <select id="findByOwner" resultMap="DiscussionPostDetailResultMap">
        SELECT <include refid="Join_User_Column_List"/>
        FROM discussion_post p
        LEFT JOIN users u ON p.user_id = u.id
        WHERE p.owner_id = #{ownerId} AND p.owner_type = #{ownerType}
        ORDER BY p.create_time ASC
    </select>

    <update id="updateContent">
        UPDATE discussion_post
        SET content = #{content}
        WHERE id = #{id}
    </update>

    <update id="softDeleteById">
        UPDATE discussion_post
        SET is_deleted = 1
        WHERE id = #{id}
    </update>

</mapper>